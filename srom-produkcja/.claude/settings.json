{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$CLAUDE_PROJECT_DIR/../_handoffs/tools/hooks/guard_module.py\"; [ -f \"$H\" ] || exit 0; /usr/bin/python3 \"$H\" srom-produkcja",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
