    c0 = colOf(ls[0]); c1 = colOf(ls[1]); cm = colOf(ls[n - 2]); cl = colOf(ls[n - 1]);
    if (c0 !== null && c1 !== null && c0 !== c1) { out.push({kind: "SZEWC", page: pageOf(ls[0]), para: p, text: head(p)}); }
    if (cm !== null && cl !== null && cm !== cl) { out.push({kind: "BĘKART", page: pageOf(ls[n - 1]), para: p, text: head(p)}); }
    if (has(CONF.short_last_line, st)) {
      last = lc[n - 1].replace(/[\r\n\s]+$/, ""); prev = lc[n - 2];
      words = last.split(/\s+/);
