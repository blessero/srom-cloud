// srom_final_pass.jsx — last pass after the text is flowed and the pages are final (Kanon § 3.6 "Łamanie").
// Generated by scripts/make_style_setup.py from indesign/style_spec.json ("final_pass") — do not edit by hand.
// Finds what only shows on the page:
//   SZEWC      first line of a paragraph alone at the foot of a column (min. 2 lines before a break)
//   BĘKART     last line of a paragraph alone at the top of a column (min. 2 lines after a break)
//   WDOWA      last line of a paragraph too short (fewer than N characters) or only the end of a hyphenated word
//   ŚRÓDTYTUŁ  a heading closes a column
//   SIEROTKA   a one-letter word (a i o u w z) at the end of a line
//   PÓŁPAUZA   a line starting with a dash (outside lists)
//   URL        a URL broken other than after "/" or before "."
//   DZIELENIE  a capitalised word (name, abbreviation) or a number/call number split at the end of a line
//   OVERSET, fonts other than the house font, missing fonts; hyphen at a page turn (info)
// Mode "fix": SZEWC, BĘKART and WDOWA are remedied as vol. 18 did by hand — paragraph tracking −5/−10/+5/+10 on the
// paragraph or one of the three before it in the same column; a change is kept only if that problem goes and no new
// one appears in its column and the next. Everything the script changes is ONE undo step (Edit ▸ Undo).
// Scope: the story with the text cursor, else every story of the document with more than 300 characters.
// Report next to the document: <name>_final_pass.txt.   Notes are checked too (a split footnote is a paragraph).
//@target indesign

var CONF = /*CONF*/;
var LOG = [], DOC = null, T0 = new Date().getTime();
function outOfTime() { return new Date().getTime() - T0 > CONF.time_budget_s * 1000; }
function log(s) { LOG.push(s); }
function has(list, x) { var i; for (i = 0; i < list.length; i++) { if (list[i] === x) { return true; } } return false; }
function styleName(p) { try { return p.appliedParagraphStyle.name; } catch (e) { return ""; } }
