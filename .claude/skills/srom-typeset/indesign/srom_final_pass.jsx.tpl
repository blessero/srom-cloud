}
function pageOf(line) {
  try { var pg = line.parentTextFrames[0].parentPage; return pg ? pg.name : "?"; } catch (e) { return "?"; }
}
function isRecto(line) {
  try { return line.parentTextFrames[0].parentPage.side === PageSideOptions.RIGHT_HAND; } catch (e) { return false; }
}

// all problems of one paragraph -> [{kind, page, para, text}]
function paraIssues(p, out) {
  var st = styleName(p), ls, n, c0, c1, cl, cm, txt, last, prev, i, lc, words;
  if (has(CONF.skip_styles, st)) { return; }
  try { if (p.parent.constructor.name === "Cell") { return; } } catch (e0) {}
  ls = p.lines; n = ls.length;
