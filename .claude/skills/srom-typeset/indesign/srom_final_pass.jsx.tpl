  }
  for (i = 0; i < n; i++) {
    txt = lc[i];
    if (i < n - 1 && /(^|\s)[aiouwzAIOUWZ] $/.test(txt)) { out.push({kind: "SIEROTKA", page: pageOf(ls[i]), para: p, text: "„…" + txt.slice(-20) + "”"}); }
    if (i > 0 && /^[–—] /.test(txt) && !has(CONF.lists, st)) { out.push({kind: "PÓŁPAUZA", page: pageOf(ls[i]), para: p, text: "„" + txt.substr(0, 25) + "…”"}); }
    if (i < n - 1 && /(https?:\/\/|www\.|doi\.org)\S*$/.test(txt) && !/\/$/.test(txt) && !/^\./.test(lc[i + 1])) {
      out.push({kind: "URL", page: pageOf(ls[i]), para: p, text: "„…" + txt.slice(-30) + "”"});
    }
    if (i < n - 1 && /[A-Za-zÀ-ž0-9]$/.test(txt) && /^[A-Za-zÀ-ž0-9]/.test(lc[i + 1]) && !/(https?:\/\/|www\.)\S*$/.test(txt)) {
      var tok = txt.split(/\s/).pop();
      if (/^[A-ZÀ-ÖØ-ÞĄĆĘŁŃÓŚŹŻ]/.test(tok) || /\d/.test(tok)) { out.push({kind: "DZIELENIE", page: pageOf(ls[i]), para: p, text: "„" + tok + "-” (" + head(p) + ")"}); }
    }
  }
  // info: hyphen at a page turn (last line of a right-hand page ends inside a word)
  for (i = 0; i < n - 1; i++) {
    if (isRecto(ls[i]) && colOf(ls[i]) !== colOf(ls[i + 1]) && /[A-Za-zÀ-ž]$/.test(lc[i]) && /^[a-zà-ž]/.test(lc[i + 1])) {
      out.push({kind: "info: dzielenie na odwrocie", page: pageOf(ls[i]), para: p, text: "„…" + lc[i].slice(-20) + "”"});
    }
  }
}
function storyIssues(story) {
  var out = [], ps = story.paragraphs, i, fns = story.footnotes, j, k;
  for (i = 0; i < ps.length; i++) {
    try { if (ps[i].lines.length && colOf(ps[i].lines[0]) === null) { break; } } catch (e) {}   // the rest is overset
    paraIssues(ps[i], out);
  }
  for (j = 0; j < fns.length; j++) { for (k = 0; k < fns[j].paragraphs.length; k++) { paraIssues(fns[j].paragraphs[k], out); } }
  return out;
}
function isNote(p) { try { return p.parent.constructor.name === "Footnote"; } catch (e) { return false; } }
function prevPara(p) { try { var q = p.parentStory.paragraphs.previousItem(p); return q && q.isValid ? q : null; } catch (e) { return null; } }
function nextPara(p) { try { var q = p.parentStory.paragraphs.nextItem(p); return q && q.isValid ? q : null; } catch (e) { return null; } }
function fixable(k) { return k === "SZEWC" || k === "BĘKART" || k === "WDOWA" || k === "PUSTY WIERSZ"; }
// white space (spaces, forced line breaks) before the paragraph end: removed — it carries nothing
function stripEnd(p) {
  var c = p.characters, k = c.length - 1, n = 0;
  if (k >= 0 && c[k].contents === "\r") { k--; }
  while (k >= 0 && (c[k].contents === " " || c[k].contents === SpecialCharacters.FORCED_LINE_BREAK || c[k].contents === "\n" ||
         c[k].contents === SpecialCharacters.NONBREAKING_SPACE)) { c[k].remove(); k--; n++; }
  return n;
}
function same(a, b) { return a.kind === b.kind && a.para.index === b.para.index && isNote(a.para) === isNote(b.para) && a.page === b.page; }
function trackingOf(p) { var t = p.tracking; return typeof t === "number" ? t : null; }

// issues in the paragraphs around p: from three paragraphs before it to the end of the column after its own
function localIssues(p) {
  var out = [], q = p, i, c0, c, seen = 0, passed = false, r;
  if (isNote(p)) { paraIssues(p, out); return out; }
  for (i = 0; i < 3; i++) { r = prevPara(q); if (!r) { break; } q = r; }
  try { c0 = colOf(q.lines[-1]); } catch (e0) { c0 = null; }
