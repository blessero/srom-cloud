if (typeof SROM_TARGET_DOC !== "undefined" && SROM_TARGET_DOC !== null) { main(); }
else { app.doScript(main, ScriptLanguage.JAVASCRIPT, undefined, UndoModes.ENTIRE_SCRIPT, "SROM final pass"); }
