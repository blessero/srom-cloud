      } else if (bare.length < CONF.min_last_line_chars || (split && bare.length <= CONF.max_fragment_chars)) {
        out.push({kind: "WDOWA", page: pageOf(ls[n - 1]), para: p, text: "„" + last + "” — " + head(p)});
      }
