    iss = storyIssues(story);
    if (mode === "fix") {
      for (i = 0; i < iss.length; i++) {
        if (!fixable(iss[i].kind)) { continue; }
        if (outOfTime()) { log("   ! time budget (" + CONF.time_budget_s + " s) used up: the rest reported, not fixed"); break; }
        var now = localIssues(iss[i].para), present = false;
        for (j = 0; j < now.length; j++) { if (same(now[j], iss[i])) { present = true; } }
