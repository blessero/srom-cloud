function doneOnly(list) { var o = [], i; for (i = 0; i < list.length; i++) { if (list[i].done) { o.push(list[i]); } } return o; }

function main() {
  var batch = typeof SROM_TARGET_DOC !== "undefined" && SROM_TARGET_DOC !== null;
  if (!batch && app.documents.length === 0) { alert("SROM final pass: open the document first."); return; }
  var doc = batch ? SROM_TARGET_DOC : app.activeDocument, mode = batch ? SROM_MODE : null, stories = [], i;
  DOC = doc;
  if (!batch) {
    var dlg = app.dialogs.add({name: "SROM – ostatni przebieg (Kanon § 3.6)"}), col = dlg.dialogColumns.add(), rb;
    col.staticTexts.add({staticLabel: "Szewce, bękarty, wdowy, śródtytuły na dole łamu, sierotki, URL, dzielenie, overset, fonty."});
    rb = col.radiobuttonGroups.add();
    rb.radiobuttonControls.add({staticLabel: "Tylko raport", checkedState: true});
    rb.radiobuttonControls.add({staticLabel: "Popraw (światło akapitu ±5/±10) i raport — jeden krok cofania"});
    if (!dlg.show()) { dlg.destroy(); return; }
    mode = rb.selectedButton === 1 ? "fix" : "report"; dlg.destroy();
  }
  try { if (!batch && app.selection.length && app.selection[0].parentStory) { stories.push(app.selection[0].parentStory); } } catch (e) {}
