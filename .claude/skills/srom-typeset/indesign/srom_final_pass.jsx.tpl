  try { f = line.parentTextFrames[0]; } catch (e) { return null; }
  if (!f || !f.isValid) { return null; }
  var key = String(f.id), n = 1;
  try { n = f.textFramePreferences.textColumnCount; } catch (e1) {}
  if (n > 1) {
    var b = f.geometricBounds, w = (b[3] - b[1]) / n;
    key += ":" + Math.floor((line.horizontalOffset - b[1]) / w);
