  f.encoding = "UTF-8";
  if (f.open("w")) { f.write(LOG.join("\r")); f.close(); }
  if (!batch) { alert(LOG.slice(0, 40).join("\r") + (LOG.length > 40 ? "\r… (full report: " + f.name + ")" : "")); }
