  for (i = 0; i < all.length; i++) {
    if (all[i].done) { log("   fixed  p. " + all[i].page + "  " + all[i].kind + "  " + all[i].text + "  → " + all[i].done); }
  }
  for (i = 0; i < all.length; i++) {
    if (all[i].done) { continue; }
    if (all[i].kind.indexOf("info") === 0) { log("   info   p. " + all[i].page + "  " + all[i].kind.substr(6) + "  " + all[i].text); continue; }
